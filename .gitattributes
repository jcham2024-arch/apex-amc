# Normalise line endings so CRLF/LF churn does not produce noisy diffs.
* text=auto eol=lf

*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.toml text eol=lf

*.png  binary
*.jpg  binary
*.pdf  binary
