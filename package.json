{
  "name": "apex-project",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "schema:check": "node scripts/check-schema.mjs",
    "seed:check": "node scripts/check-seeds.mjs",
    "data:fetch": "node scripts/fetch-published-data.mjs",
    "data:snapshot": "node scripts/export-d1.mjs",
    "data:extract": "node scripts/extract-kwk-pressures.mjs && node scripts/extract-leverguns-pressures.mjs && node scripts/extract-vihtavuori-burn-rate.mjs && node scripts/crosscheck-pressures.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-strip-types --test \"packages/ballistics-core/test/*.test.ts\"",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run schema:check && npm run seed:check",
    "website:dev": "npm run dev --workspace apps/website",
    "website:build": "npm run build --workspace apps/website"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}

