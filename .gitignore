# Dependencies
node_modules/

# Expo
.expo/
dist/
.web/
expo-env.d.ts

# Build output
build/
out/
.next/
.wrangler/

# Environment / secrets - never commit
.env
.env.*
!.env.example

# Cloudflare D1 local state
*.sqlite
*.sqlite-journal
.d1/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Archived third-party published documents. Retained locally for citation so a
# data row's source can be re-checked; they are other people's copyright and
# must never be redistributed by the site. The provenance manifest is committed.
data/published/*
!data/published/manifest.json
!data/published/MANIFEST.md

# Research staging area produced by the harvesting agents. The curated results
# land in data/seeds/; raw drops are not reference data.
#
# Nothing the loader reads may live here. Until 2026-10-01 the powders manifest
# merged data/incoming/powders/ alongside data/seeds/powders/, so 142 of the 169
# powder rows came from this gitignored directory and a fresh clone loaded 27.
# Row counts that depend on the checkout instead of the repository are worse than
# no data at all. See scripts/promote-powders.mjs.
data/incoming/

# Generated SQLite database built by scripts/data/load-seeds-to-sqlite.mjs
# (`npm run data:sqlite`). A build artefact, not source: it is fully reproducible from
# data/seeds/ in under a second, and committing a binary that drifts from its inputs is
# how a snapshot goes stale without anyone noticing.
data/generated/

# Generated D1 migration snapshot, ~3.1 MB. Rebuilt from data/published/
# manifest.json - which IS committed - by `npm run data:snapshot`, and verified
# to be unnecessary for `npm run seed:check`. Committing a generated artifact
# this size means every clone carries it and it can drift from its own source.
data/schema/100_seed_full_snapshot.sql

# data/generated/ - build artefacts. A SQLite database built by `npm run data:sqlite` is
# a build output like the snapshot above, and for the same reason: it is fully derivable
# from data/seeds/ plus data/schema/, so committing it means every clone carries a binary
# that can silently drift from its own source. It also should not be committed by accident
# - a .db file in a diff is unreadable and unreviewable, which defeats code review.
data/generated/

# Archive is kept in git for provenance, but exclude the huge
# raw AI transcript from language servers and typecheckers.
archive/**/*.txt

# ---------------------------------------------------------------------------
# Agent scratch. Parallel data agents leave diagnostic and repair scripts behind;
# they are not part of the build. These are ignored rather than deleted, because
# another agent may still be mid-run and own them.
#
# This was not cosmetic: `npm run verify` runs `eslint .`, and scratch scripts
# using `console`/`Buffer` under a Node-source lint config produced 40 errors,
# which made the whole build look broken while every real source file was clean.
# ---------------------------------------------------------------------------
tmp/
temp/
output*.txt
**/_tmp-*.mjs
**/_tmp-*/

# ---------------------------------------------------------------------------
# tasking/completed/ - Sub-Agent hand-off, and the project's research record.
#
# WHAT CHANGED ON 2 OCT 2026, AND WHY
# -----------------------------------
# This was previously ignored, on the reasoning that a staged copy is "a diff under
# review, not project source". That reasoning was sound for CODE copies and wrong
# for RESEARCH output, and the cost was severe:
#
#   Agents were dispatched from tasking/pending/. They finished. They wrote their
#   findings into tasking/completed/. And because that folder was ignored, those
#   findings did not exist for anyone else - not in git, not in a clone, not after
#   a session closed. The queue looked identical before and after the entire
#   research phase. The work was real and it was already gone.
#
# The distinction the old rule missed:
#
#   A STAGED CODE COPY is a proposal. It is superseded the moment it is merged, and
#   committing it puts two copies of one file in the repo, so a stale one can be
#   mistaken for the real one. Ignoring those is correct.
#
#   TASK RESEARCH OUTPUT is not a proposal. It is the ONLY durable record of what
#   was learned - which sources were checked, what was measured, what was refused
#   and why. It does not get "merged" into anything, because there is nothing to
#   merge it into. Ignoring it makes it evaporate.
#
# So: code-path output stays ignored (see the narrow rule below), and RESEARCH
# output is now tracked. Every task's `required_outputs` lives under its own folder
# and is enforced by `npm run tasking:check`.
#
# The lint/docs problem that motivated the old rule is real, and is handled by the
# staged-code carve-out directly beneath rather than by ignoring the whole tier.
# ---------------------------------------------------------------------------
tasking/completed/*

# RESEARCH OUTPUT IS TRACKED. This is the fix for the incident above.
# A task folder's own manifest, brief, and findings are the project record.
!tasking/completed/*/
!tasking/completed/*/**
tasking/completed/**/tmp/
tasking/completed/**/node_modules/

# STAGED CODE COPIES stay ignored, for the original reason: they duplicate a file
# that already has a canonical home in the repo.
tasking/completed/**/*.mjs
tasking/completed/**/*.js
tasking/completed/**/*.ts
tasking/completed/**/*.tsx
tasking/completed/**/*.json
tasking/completed/**/*.css
tasking/completed/**/*.html

# ...but the manifests are .json and MUST be tracked, or `tasking:check` cannot
# verify a completed task against what it declared. The rule below is the narrow
# exception that keeps the check honest.
!tasking/completed/*/task.json
!tasking/completed/*/**/task.json

# ...and the directory must exist on a clean checkout, or every agent starts by
# creating it. Git does not track empty directories.
!tasking/completed/.gitkeep

# ---------------------------------------------------------------------------
# tasking/in-progress/ and tasking/review/ - the other two swarm tiers.
#
#   in-progress/  an agent's LIVE workspace. Ephemeral by design: it is
#                 mid-flight by definition, and if the agent dies a reassigned
#                 one restarts from the brief rather than half-inheriting an
#                 undocumented intermediate state.
#   review/       the review agent's findings. Written TO the swarm, so every
#                 agent can read the decision that applies to it. Tracked
#                 content would be better long-term, but the folder is a
#                 scratch surface until that policy exists.
#
# Same reasoning as completed/ above: none of it is project source. The briefs
# in tasking/pending/ remain tracked and gated, which is the part that matters -
# a brief with a broken path must fail the build before an agent follows it.
# ---------------------------------------------------------------------------
tasking/in-progress/*
!tasking/in-progress/.gitkeep
# The README is the tier's protocol, not scratch. An agent arriving in an empty
# folder MUST be able to find the rules without the planner being present to
# explain them - that is the whole reason this tier exists.
!tasking/in-progress/README.md
tasking/review/*
!tasking/review/.gitkeep
!tasking/review/README.md
# DERIVED-VALUES.md is the owner's 3 Oct decision permitting review-derived values, and
# the conditions attached to it. Without it an agent cannot tell a legitimate derived
# number from a fabrication - which is the difference the whole citation rule exists to
# make. It was written, and nearly evaporated: `tasking/review/*` ignores everything
# except the allowlist below, so this file was silently uncommitted until someone checked
# that it was actually IN the repo rather than merely present on disk.
!tasking/review/DERIVED-VALUES.md
# SKILLS-ASSESSMENT.md records which of the 66 agent skills this project uses, which it
# deliberately does not, and why. Read before adding a skill to a brief: naming a tool
# nobody has, or a platform this project is not on, wastes an agent's whole turn.
!tasking/review/SKILLS-ASSESSMENT.md
# HISTORY.md is the swarm's reasoning record - why a decision was made, what an
# agent refused to do, what the evidence was. It is the one file in this folder
# that must survive, and it is exactly the kind of thing that evaporates when it
# is not committed. FINDINGS and NEXT-TASKS are scratch between reviews; this is
# not, and losing it would lose the trap history .clinerules asks for.
!tasking/review/HISTORY.md
# FIX-BACKLOG.md is the record of every defect the swarm has found and what
# happened to it. It is the one file in this folder that is BOTH the working list
# and the permanent record: findings that are closed stay here with their status,
# because the reason something was rejected is the part worth not losing. An
# ignored backlog means the same defect gets re-raised every few weeks.
!tasking/review/FIX-BACKLOG.md
# LESSONS.md is the compiled lesson set - why each mechanism of the swarm exists,
# and which incident paid for it. Compiled from swarm-improvement plus the
# corrections agents filed on each other. Read it before changing how the swarm
# works; several mechanisms exist only because I got them wrong first, and a
# lesson with no incident attached is a slogan rather than knowledge.
!tasking/review/LESSONS.md
# PRODUCT.md is the owner's statement of what the site is for, plus what is
# blocked and why. It is the test every later proposal is measured against -
# and the reason two obvious features (live pricing, load ladders) are deliberately
# NOT being built the obvious way.
!tasking/review/PRODUCT.md
# tasking/mail/ - inter-agent communication. TRACKED, unlike the other swarm tiers,
# and the reason matters: a mailbox that is not committed is a message that never
# arrived. The agents live in separate git worktrees, so an uncommitted message is
# invisible to the taskmaster and to every other agent - which is the entire failure
# this folder exists to fix. Re-committing after the fact cannot recover a message
# written to an ignored file, because the bytes were never in the repo.
!tasking/mail/

# Scratch scripts, recognisable by the leading underscore or an iterative name.
# Real scripts are verb-named and single-file (check-seeds.mjs, build-data.mjs).
scripts/_*.mjs
scripts/fix_*.mjs
scripts/fix_*.ps1
scripts/remove_*.mjs
scripts/remove_*.ps1
scripts/replace_*.mjs
scripts/test_read_csv*.mjs
scripts/fix_encoding.ps1

# Throwaway scripts written to the REPOSITORY ROOT while investigating.
#
# The rules above all assume scratch lives under scripts/. That assumption cost
# us: c.mjs, c2.mjs and f.mjs were written to the root, committed by an
# `add --all`, and shipped to the remote. CI's lint step is what finally caught
# one of them ("'console' is not defined"), on the first run this repo ever had
# on ubuntu-latest.
#
# This is deliberately broad. A root-level .mjs is never a real project file -
# every real script lives in scripts/ - so ignoring the whole pattern costs
# nothing and removes the whole class of accident.
/*.mjs

# Backups written by scripts/repair-encoding.mjs. Local safety copies only -
# the repaired originals are the files that belong in git.
*.pre-encoding-fix.bak

